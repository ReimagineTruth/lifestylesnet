# SQLite database file path (default: ./data/lifestyles.db)
DATABASE_URL=file:./data/lifestyles.db

# Admin dashboard password (default: lifestyles-admin)
ADMIN_PASSWORD=lifestyles-admin

# PayMongo — server only (never expose secret key in VITE_ vars)
PAYMONGO_SECRET_KEY=sk_live_your_secret_key
PAYMONGO_PUBLIC_KEY=pk_live_your_public_key
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret

# Public site URL for payment return redirects and webhooks
PUBLIC_SITE_URL=http://localhost:8080
VITE_PUBLIC_SITE_URL=http://localhost:8080

# Safe for frontend
VITE_PAYMONGO_PUBLIC_KEY=pk_live_your_public_key

