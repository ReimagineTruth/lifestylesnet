{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifestylesnet",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifestylesnet",
      "migrations_dir": "drizzle"
    }
  ]
}
